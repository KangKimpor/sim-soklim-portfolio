# that tools/make_public_cv.py produces from it.
assets/Sim-Soklim-CV-original.pdf

# Node tooling artefacts, if anyone runs the Vercel CLI in here
node_modules/
package-lock.json

# Python bytecode from the tools
__pycache__/
*.py[cod]

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor / OS noise
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
